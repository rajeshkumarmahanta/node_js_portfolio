<%- include('partials/head') %>
<%- include('partials/page-header', { eyebrow: 'Who I am', heading: about.heading, subheading: about.subheading }) %>

<section class="section pt-0">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-7">
        <% about.bio.forEach(function (p) { %>
          <p class="fs-6 text-soft-strong mb-3 lh-lg"><%= p %></p>
        <% }) %>
      </div>
      <div class="col-lg-5">
        <div class="facts-card">
          <% about.quickFacts.forEach(function (f) { %>
            <div class="fact">
              <i class="bi <%= f.icon %>"></i>
              <div>
                <div class="fact-label"><%= f.label %></div>
                <div class="fact-value"><%= f.value %></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SKILLS -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Toolbox</p>
      <h2 class="section-title">Skills &amp; Technologies</h2>
    </div>
    <div class="row g-4">
      <% about.skillGroups.forEach(function (g) { %>
        <div class="col-md-6 col-lg-4">
          <div class="skill-card h-100 reveal">
            <div class="d-flex align-items-center gap-2 mb-3">
              <div class="icon-box icon-box-sm"><i class="bi <%= g.icon %>"></i></div>
              <h3 class="h6 mb-0"><%= g.title %></h3>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <% g.skills.forEach(function (s) { %><span class="chip chip-lg"><%= s %></span><% }) %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- EXPERIENCE -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Journey</p>
      <h2 class="section-title">Experience</h2>
    </div>
    <div class="timeline">
      <% about.experience.forEach(function (e) { %>
        <div class="timeline-item reveal">
          <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
            <h3 class="h5 mb-0"><%= e.role %></h3>
            <span class="period"><%= e.period %></span>
          </div>
          <p class="text-accent small mb-3"><%= e.company %></p>
          <ul class="tick-list mb-0">
            <% e.points.forEach(function (pt) { %><li><%= pt %></li><% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- VALUES -->
<section class="section section-alt">
  <div class="container">
    <div class="row g-4">
      <% about.values.forEach(function (v) { %>
        <div class="col-md-4">
          <div class="service-card h-100 reveal">
            <div class="icon-box"><i class="bi <%= v.icon %>"></i></div>
            <h3 class="h5 mt-3 mb-2"><%= v.title %></h3>
            <p class="text-soft small mb-0"><%= v.text %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
