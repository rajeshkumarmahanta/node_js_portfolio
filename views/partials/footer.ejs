</main>

<footer class="site-footer">
  <div class="container">
    <div class="row gy-4 align-items-center">
      <div class="col-md-5">
        <a class="brand mb-2 d-inline-flex" href="/">
          <span class="brand-mark"><%= site.shortName %></span>
          <span class="brand-text"><%= site.name %></span>
        </a>
        <p class="text-soft small mb-0"><%= site.role %> · <%= site.location %></p>
      </div>
      <div class="col-md-4">
        <ul class="list-inline mb-0 footer-links">
          <% site.nav.forEach(function (item) { %>
            <li class="list-inline-item"><a href="<%= item.href %>"><%= item.label %></a></li>
          <% }) %>
        </ul>
      </div>
      <div class="col-md-3 text-md-end">
        <% site.socials.forEach(function (s) { %>
          <a class="social-btn" href="<%= s.url %>" target="<%= s.url.startsWith('mailto') ? '_self' : '_blank' %>" rel="noopener" aria-label="<%= s.label %>"><i class="bi <%= s.icon %>"></i></a>
        <% }) %>
      </div>
    </div>
    <hr class="footer-rule">
    <div class="d-flex flex-column flex-md-row justify-content-between small text-soft gap-2">
      <span>&copy; <%= year %> <%= site.name %>. All rights reserved.</span>
      <span><%= site.footerNote %></span>
    </div>
  </div>
</footer>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="copyToast" class="toast align-items-center border-0" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body"><i class="bi bi-check2-circle me-2"></i>Email copied to clipboard</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
