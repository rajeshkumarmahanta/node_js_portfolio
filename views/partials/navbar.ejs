<nav class="navbar navbar-expand-lg fixed-top site-nav" id="siteNav">
  <div class="container">
    <a class="navbar-brand brand" href="/">
      <span class="brand-mark"><%= site.shortName %></span>
      <span class="brand-text"><%= site.name %></span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list fs-2"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
        <% site.nav.forEach(function (item) {
             const active = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href); %>
          <li class="nav-item">
            <a class="nav-link <%= active ? 'active' : '' %>" href="<%= item.href %>" <%= active ? 'aria-current=page' : '' %>><%= item.label %></a>
          </li>
        <% }) %>
        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
          <a class="btn btn-accent btn-sm px-3" href="mailto:<%= site.email %>"><i class="bi bi-envelope me-1"></i> Hire me</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
