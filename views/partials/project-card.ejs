<a href="/portfolio/<%= project.slug %>" class="project-card h-100" style="--card-accent: <%= project.accent %>;" data-tags="<%= project.tags.join('|') %>">
  <div class="project-thumb">
    <i class="bi <%= project.icon %>"></i>
    <span class="project-category"><%= project.category %></span>
  </div>
  <div class="project-body">
    <h3 class="h5 mb-2"><%= project.title %></h3>
    <p class="text-soft small mb-3"><%= project.summary %></p>
    <div class="d-flex flex-wrap gap-1 mb-3">
      <% project.tech.forEach(function (t) { %><span class="chip"><%= t %></span><% }) %>
    </div>
    <span class="link-arrow">View details <i class="bi bi-arrow-right"></i></span>
  </div>
</a>
